// Change these before provisioning or creating CloudKit production records.
BUNDLE_IDENTIFIER = com.personal.Wateera
WIDGET_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER).widgets
APP_GROUP_IDENTIFIER = group.$(BUNDLE_IDENTIFIER)
CLOUDKIT_CONTAINER_IDENTIFIER = iCloud.$(BUNDLE_IDENTIFIER)
// Development signing uses development/Development. Ad Hoc profiles typically
// use production/Production; match these values to the selected profile.
APS_ENVIRONMENT = development
CLOUDKIT_ENVIRONMENT = Development
DEVELOPMENT_TEAM =
MARKETING_VERSION = 2.0.0
CURRENT_PROJECT_VERSION = 6
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
TARGETED_DEVICE_FAMILY = 1
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CODE_SIGN_STYLE = Manual
CODE_SIGNING_ALLOWED = NO
// Siri is deferred: do not run the App Intents metadata producer for these targets.
// Swift Build source: Sources/SWBApplePlatform/AppIntentsMetadataTaskProducer.swift.
LM_SKIP_METADATA_EXTRACTION = YES
